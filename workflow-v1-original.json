    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=Set human_review_required to false for clear, general requests for approved educational resources, webinars, company information, molecular profiling information, or precision-oncology information.\n\nSet human_review_required to true only for:\n- adverse events or side effects\n- off-label or unapproved-use requests\n- patient-specific treatment recommendations\n- safety, legal, or compliance issues\n- genuinely unclear enquiries\n\nReturn ONLY one valid JSON object.\nDo not write “Understood”, explanations, greetings, markdown, or ```json fences.\nYour entire response must begin with { and end with }."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        896,
        64
      ],
      "id": "7a99cd61-a9e2-4049-8a29-5cbd04c83bc9",
      "name": "AI Classify Enquiry and Recommend Action"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst originalData =\n  $('Query Requires Medical Review?').first().json;\n\ntry {\n  const rawText = input.output?.[0]?.content?.[0]?.text;\n\n  if (typeof rawText !== 'string' || !rawText.trim()) {\n    throw new Error('AI response is missing or empty');\n  }\n\n  const cleanText = rawText.trim()\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/\\s*```$/, '')\n    .trim();\n\n  const aiResult = JSON.parse(cleanText);\n\n  if (!aiResult || typeof aiResult !== 'object' ||\n      Array.isArray(aiResult)) {\n    throw new Error('AI response must be a JSON object');\n  }\n\n  if (typeof aiResult.human_review_required !== 'boolean') {\n    throw new Error('human_review_required must be a boolean');\n  }\n\n  return [{\n    json: {\n      ...aiResult,\n      ...originalData,\n      human_review_required: aiResult.human_review_required,\n      ai_output_valid: true,\n      ai_output_error: ''\n    }\n  }];\n} catch (error) {\n  return [{\n    json: {\n      ...originalData,\n      ai_output_valid: false,\n      ai_output_error: error.message,\n      human_review_required: true\n    }\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
