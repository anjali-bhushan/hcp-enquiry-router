        "jsCode": "const hcp = $('Prepare CRM Follow-up').first().json;\nconst rows = $input.all().map(item => item.json);\n\nconst normalize = value =>\n  String(value ?? '').trim().toLowerCase();\n\nconst usableRows = rows.filter(row =>\n  String(row['Content Title'] ?? '').trim() &&\n  /^https?:\\/\\/\\S+$/i.test(\n    String(row['Approved Link'] ?? '').trim()\n  )\n);\n\nconst content =\n  usableRows.find(row =>\n    normalize(row.Specialty) === normalize(hcp.Specialty)\n  ) ||\n  usableRows.find(row =>\n    normalize(row.Specialty) === 'all'\n  );\n\nreturn [{\n  json: {\n    ...hcp,\n    approved_content_found: Boolean(content),\n    approved_content_title: content?.['Content Title'] || '',\n    approved_content_link:\n      String(content?.['Approved Link'] ?? '').trim(),\n    approved_content_type: content?.['Content Type'] || '',\n    approved_content_topic: content?.Topic || '',\n    content_review_reason: content\n      ? ''\n      : `No usable approved content found for specialty: ${hcp.Specialty}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
